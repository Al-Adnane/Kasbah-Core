{
  "version": "2.0.0",
  "governance": {
    "forbidden_verbs": [
      "DELETE_FILE",
      "DROP_TABLE",
      "EVAL",
      "EXEC",
      "ESCALATE_PRIVILEGE",
      "ACCESS_SECRETS",
      "EXFILTRATE_DATA",
      "RUN_AS_ROOT"
    ],
    "allowed_domains": [
      "api.internal.kasbah.com",
      "data.kasbah.com",
      "research.internal",
      "analytics.internal"
    ],
    "rate_limits": {
      "READ_per_minute": 500,
      "WRITE_per_minute": 50,
      "DELETE_per_minute": 1,
      "SEND_per_minute": 10
    },
    "require_approval": [
      "DEPLOY",
      "PUSH_CODE",
      "MODIFY_INFRA",
      "BULK_EXPORT"
    ]
  },
  "metadata": {
    "org": "kasbah",
    "policy_owner": "Security Team",
    "compliance_packs": ["SOC2"],
    "notes": "Default Kasbah Agent OS policy. Blocks destructive ops. Allows internal API access.",
    "created_at": "2026-03-21T00:00:00Z"
  }
}
