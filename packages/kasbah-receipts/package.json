  },
  "files": [
    "src/",
    "bin/",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "@noble/post-quantum": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@noble/post-quantum": {
      "optional": true
    }
  },
  "keywords": [
    "ai",
    "agents",
    "audit",
    "receipts",
    "ed25519",
    "ml-dsa",
    "post-quantum",
    "provenance",
    "attestation",
    "governance",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kasbah-ai/receipts"
  }
}
