# Kasbah AI Safety Platform - Environment Configuration

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://kasbah:changeme@localhost:5432/kasbah
POSTGRES_USER=kasbah
POSTGRES_PASSWORD=changeme

# Redis (caching)
REDIS_URL=redis://localhost:6379/0

# Monitoring & Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
MAX_UPLOAD_SIZE_MB=100
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Kasbah signing secrets (REQUIRED for durable receipts — without these,
# receipts use ephemeral per-process dev keys and will not verify across restarts)
KASBAH_RECEIPT_SECRET=
KASBAH_TICKET_SECRET=
KASBAH_JWT_SECRET=

# SIEM connectors (optional — enterprise fleet visibility; see packages/api-server/src/siem-connectors.js)
KASBAH_SPLUNK_HEC_URL=
KASBAH_SPLUNK_TOKEN=
KASBAH_SPLUNK_INDEX=kasbah
KASBAH_DD_API_KEY=
KASBAH_DATADOG_URL=https://api.datadoghq.com
KASBAH_SIEM_WEBHOOK_URL=
KASBAH_SIEM_WEBHOOK_TOKEN=

# Features (Can be toggled)
FEATURE_SPATIAL_INTELLIGENCE=true
FEATURE_GENERATOR_ATTRIBUTION=true
FEATURE_CONFIDENCE_CALIBRATION=true
FEATURE_QUANTUM_SIGNATURES=false
FEATURE_ZERO_KNOWLEDGE_PROOFS=false
FEATURE_ISLAMIC_ETHICS=true

# External Services
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs — one pair per tier (monthly / annual). billing.js reads
# these to build checkout sessions and to resolve a subscription back to a tier.
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_ANNUAL=
STRIPE_PRICE_DEVELOPER_MONTHLY=
STRIPE_PRICE_DEVELOPER_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_200=
STRIPE_PRICE_CREDITS_1000=

# Email (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kasbah.ai

# Slack Integration (optional)
SLACK_WEBHOOK_URL=

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./data

# Deployment
DEPLOYMENT_ENVIRONMENT=local
VERSION=2.0.0-dev
